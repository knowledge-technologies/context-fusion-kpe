# Personal/cluster settings
USERNAME=your-username
GPU_ID=0

# Server hostnames
KT_GPU2_HOST=kt-gpu2-host
KT_GPU4_HOST=kt-gpu4-host

# Proxy settings (for container build and runtime)
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=127.0.0.0/8,0.0.0.0,localhost

DATASET_FOLDER=/path/to/your/dataset/location

# Directory where experiment runs (checkpoints, logs, predictions) are stored.
# Defaults to $DATASET_FOLDER/runs if not set.
EXPERIMENT_RUNS_FOLDER=/path/to/your/runs/location

# Optional: Weights & Biases experiment tracking.
# Install the tracking extra first: uv pip install "keyword-pecker[tracking]"
# Then set WANDB_API_KEY and pass --wandb to train.py to enable logging.
WANDB_API_KEY=
WANDB_PROJECT=keyword-pecker
WANDB_ENTITY=
